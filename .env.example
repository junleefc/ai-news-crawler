# 이 파일을 복사해서 .env 로 만들고 값을 채우세요 (로컬 테스트용).
# GitHub 에서는 대신 Settings > Secrets 에 같은 이름으로 등록합니다.

# Claude API 키 (https://console.anthropic.com/ → API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 슬랙 Incoming Webhook URL (#ai_news 채널로 연결)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# 구글 시트 ID (시트 URL 의 /d/ 와 /edit 사이 문자열)
SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# 구글 서비스계정 키 JSON (통째로 한 줄 문자열). 로컬에선 아래처럼 작은따옴표로 감싸기
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'
